# Copy to .env (gitignored) and fill in locally. Never commit .env. Names only here.
# Server and vision
SERVER_PORT=8000
VISION_URL=http://127.0.0.1:8001
# Brain (Claude) and backup brain switch
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude
GROK_API_KEY=
# Voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Market
APIFY_TOKEN=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
# Store
CONVEX_URL=
CONVEX_DEPLOY_KEY=
# Privacy: 1 keeps frames on our own vision host only (never a cloud model)
LOCAL_ONLY=0

# Shared secret required before exposing a public tunnel
A_EYE_TOKEN=
# Set to 1 for offline phone testing
A_EYE_MOCK=
TWELVELABS_API_KEY=
